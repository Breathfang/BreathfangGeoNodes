# ===========================================================================
#  .github/scripts - shared settings
#
#  The single .env for every Python script in this folder. There is no .env in
#  functions/ and no per-script file: nightly_builder.py, nightly_cleaner.py,
#  blend_scanner.py and python_security_scanner.py all read this one.
#
#  Format: KEY=VALUE, one per line. # starts a comment. Wrap a value in
#  matching single or double quotes if it needs to keep spaces. A real
#  environment variable always wins over the value written here.
#
#  This file IS committed, and it is the single source of truth for the
#  settings below. That is deliberate: NIGHTLY_BUILDS_ENABLED has to reach CI
#  through a diff, so a private untracked copy would let a maintainer believe
#  they had flipped the pipeline when they had not. Edit it here and commit.
#
#  Every setting still falls back to a built-in default when the key is absent,
#  so a missing or truncated .env degrades to the previous hard-coded behaviour
#  instead of crashing. Nothing secret belongs in this file.
# ===========================================================================

# ---------------------------------------------------------------------------
#  Master toggle for the nightly pipeline
# ---------------------------------------------------------------------------
#   true  -> CI builds, commits and pushes the nightly snapshot
#   false -> the pipeline short-circuits; nothing is built, pushed or deleted
# Local and manual runs are NOT affected by this, only GitHub Actions.
# The workflow reads this through nightly_builder.BUILDS_ENABLED, so flipping it
# here and committing is what actually resumes the pipeline.
#
# Note: on.push.paths only matches "DragonGraph's Project/**", so committing
# this change arms the pipeline but does not trigger it. The next push that
# also touches DragonGraph's Project/ is what produces a build.
NIGHTLY_BUILDS_ENABLED=false

# ---------------------------------------------------------------------------
#  Repository anchors (relative paths resolve under the repository root)
# ---------------------------------------------------------------------------
# Leave REPO_ROOT empty to auto-detect the nearest ancestor containing .git.
REPO_ROOT=
SOURCE_DIR=DragonGraph's Project
NIGHTLY_OUTPUT_DIR=DragonGraph's Nighty Build

# ---------------------------------------------------------------------------
#  Nightly archives
# ---------------------------------------------------------------------------
NIGHTLY_ZIP_NAME=Dragongraph's Toolset Pack NightlyBuilds_{hex}_{timestamp}.zip
NIGHTLY_ZIP_GLOB=Dragongraph's Toolset Pack NightlyBuilds_*.zip
ZIP_COMPRESSION_LEVEL=9
# Excluded from every nightly pack. Ranges such as .blend1-9 expand to the
# individual suffixes.
ZIP_EXCLUDED_SUFFIXES=.md,.log,.tmp,~,.orig,.rej,.blend1-9
NIGHTLY_MAX_BUILD_COUNT=10
NIGHTLY_MAX_TOTAL_SIZE_MB=300.0

# ---------------------------------------------------------------------------
#  .blend scanner
# ---------------------------------------------------------------------------
BLEND_SCAN_ROOT=DragonGraph's Project
# Optional headless Blender executable for the authoritative Text-block scan.
# Leave empty to use only the byte-level scans.
BLENDER_BINARY=
BLEND_MAX_OUTPUT_BYTES=2147483648
BLEND_MAX_BLOCKS=2000000
BLEND_MIN_RUN_LENGTH=16
BLEND_HEADLESS_TIMEOUT=120

# ---------------------------------------------------------------------------
#  Python security scanner
# ---------------------------------------------------------------------------
# Comma-separated, quoted because of the spaces.
PY_SCAN_ROOTS="DragonGraph's Project","DragonGraph's Project Utilities"
# Path parts never walked, whatever the scan roots are. The shared helpers
# under functions/ are trusted maintainer tooling that legitimately uses
# os/sys/subprocess.
SCAN_SKIP_DIRS=.git,.venv,venv,__pycache__,functions,DragonGraph's Project Utilities/functions,.github/scripts/functions

PY_DENIED_MODULES=os,sys,subprocess,shutil,ctypes,socket,ftplib,smtplib,http,http.server,urllib,urllib.request,urllib.parse,requests,pickle,marshal,imp,importlib
PY_DENIED_CALLS=eval,exec,execfile,compile,__import__,globals
PY_DENIED_ATTR_SUFFIX=system,popen,startfile,Popen,run,call,check_output,check_call,rmtree,move,remove,unlink,socket,connect,sendall,send,recv,readlink,makedirs,mkdir,open
PY_DENIED_CALLABLE_ATTRS=os.system,os.popen,os.startfile,os.remove,os.unlink,os.rmdir,subprocess.Popen,subprocess.run,subprocess.call,subprocess.check_output,subprocess.check_call,shutil.rmtree,shutil.move,shutil.copy,shutil.copyfile,shutil.copy2,socket.socket,socket.create_connection,urllib.request,urllib.urlopen,requests.get,requests.post,requests.put,requests.delete,requests.request,marshal.loads,pickle.loads
# Regexes for the raw tokenizer pass. One per line would need escaping, so they
# stay in code; set to "off" to skip that pass entirely.
PY_RAW_PATTERNS=on

# How the scanners treat a file they cannot read or parse (corrupt .blend,
# syntax error, bad encoding, permission error). These are technical faults,
# not security violations, so the default is to log a [WARNING], skip the file
# and still pass, rather than block a push over one broken file.
#   false -> [WARNING] + skip, exit 0
#   true  -> exit 2, because the scan could not be completed
SCAN_STRICT_ON_ERROR=false
# A .py containing NUL bytes or invalid UTF-8 is a real threat in this pack
# (smuggled bytecode or an encrypted payload), so it stays a hard finding.
# Set to false only if you expect broken .py fixtures.
PY_FLAG_BINARY_FILES=true

# ---------------------------------------------------------------------------
#  Git plumbing
# ---------------------------------------------------------------------------
GIT_TIMEOUT=60
GIT_DIFF_FILTER=ACMRTUXB
EMPTY_TREE_SHA=4b825dc642cb6eb9a060e54bf8d69288fbee4904
