# ===========================================================================
#  DragonGraph's Project Utilities - shared settings
#
#  The single .env for every Python tool in this folder. There is no .env in
#  functions/ and no per-script file: nodepack_zip_generator.py,
#  python_library_autosetup.py and temporary_file_cleaner.py all read this one.
#
#  The two .bat files (.docsbuild.bat,
#  language_server_taskkill_blender_save.bat) do NOT read it; they keep their
#  own settings block.
#
#  Format: KEY=VALUE, one per line. # starts a comment. Wrap a value in
#  matching single or double quotes if it needs to keep spaces. A real
#  environment variable always wins over the value written here, and every
#  setting falls back to a built-in default when it is missing, so deleting
#  this file only costs you the tweaks.
#
#  This file IS committed, and it is the single source of truth for the
#  settings below - review a change to it like any other config change. Keep
#  nothing secret in it.
# ===========================================================================

# ---------------------------------------------------------------------------
#  Repository anchors (relative paths resolve under the repository root)
# ---------------------------------------------------------------------------
# Leave REPO_ROOT empty to auto-detect the nearest ancestor containing .git.
REPO_ROOT=
SOURCE_DIR=DragonGraph's Project
RELEASE_OUTPUT_DIR=Generated Nodepacks
NIGHTLY_OUTPUT_DIR=DragonGraph's Nighty Build

# ---------------------------------------------------------------------------
#  Logging
# ---------------------------------------------------------------------------
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=5
LOG_LEVEL=DEBUG
CONSOLE_LOG_LEVEL=DEBUG
LOG_FORMAT=%(asctime)s - %(levelname)s - %(message)s
ZIP_GENERATOR_LOG=nodepack_zip_generator.log
LIBRARY_AUTOSETUP_LOG=python_library_autosetup.log

# ---------------------------------------------------------------------------
#  Console
# ---------------------------------------------------------------------------
PAUSE_PROMPT=Press enter to exit...

# ---------------------------------------------------------------------------
#  Pack ZIPs (nodepack_zip_generator.py)
# ---------------------------------------------------------------------------
ZIP_COMPRESSION_LEVEL=9
PACK_NAME_TEMPLATE=DragonGraph's Toolset Pack {node_version}
RELEASE_NAME_TEMPLATE={pack_name} - Asset Library.zip
NIGHTLY_NAME_TEMPLATE=Dragongraph's Toolset Pack NightlyBuilds_{hex}_{timestamp}.zip
DEFAULT_NODE_VERSION=v1.1.0-alpha
# Excluded from both release and nightly packs. Ranges such as .blend1-9 expand
# to the individual suffixes.
ZIP_EXCLUDED_SUFFIXES=.md,.log,.tmp,~,.orig,.rej,.blend1-9

# ---------------------------------------------------------------------------
#  Temporary-file cleaner (temporary_file_cleaner.py)
# ---------------------------------------------------------------------------
CLEANER_PAGE_SIZE=10
# Same policy the packs use, minus .md (documentation is worth keeping on disk).
CLEANER_SUFFIXES=.log,.tmp,~,.orig,.rej,.blend1-9

# ---------------------------------------------------------------------------
#  Documentation toolchain (python_library_autosetup.py)
# ---------------------------------------------------------------------------
MIN_PYTHON=3.13
# PyPI distribution names; they differ from import names for some of these
# (sphinx-autobuild is imported as sphinx_autobuild).
DOCS_PACKAGES=sphinx,sphinx-autobuild,sphinx_rtd_theme
